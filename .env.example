# Copy to .env and change every value. docker compose reads it automatically.
STAMMDATEN_API_KEY=change-me-stammdaten
VENDOR_GUARD_API_KEY=change-me-vendor-guard
# long random strings, e.g. from: openssl rand -hex 32
LINK_SECRET=change-me-link-secret
AUDIT_KEY=change-me-audit-key
# who gets approval links, comma separated
APPROVERS=leitung.buchhaltung@example.com,controlling@example.com,einkauf.leitung@example.com
